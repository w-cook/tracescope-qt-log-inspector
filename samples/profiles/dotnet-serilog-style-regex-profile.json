{
    "schemaVersion": 1,
    "name": ".NET Serilog-Style Regex",
    "importerId": "regex-text",
    "regexPattern": "^(?<timestamp>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d{3})\\s+\\[(?<level>[A-Z]{3})\\]\\s+\\[(?<category>[^\\]]+)\\]\\s+\\[(?<requestId>[^\\]]+)\\]\\s+(?<message>.*)$",
    "canonicalFields": {
        "timestamp": "timestamp",
        "severity": "level",
        "subsystem": "category",
        "eventCode": "",
        "entityId": "",
        "message": "message"
    },
    "customFields": [
        {
            "name": "Request ID",
            "sourcePath": "requestId"
        }
    ],
    "severityAliases": {
        "DBG": "DEBUG",
        "ERR": "ERROR",
        "FTL": "CRITICAL",
        "INF": "INFO",
        "VRB": "TRACE",
        "WRN": "WARNING"
    },
    "timestampRules": [
        {
            "type": "qt-format",
            "format": "yyyy-MM-dd HH:mm:ss.zzz"
        }
    ],
    "preserveUnmappedFields": true
}
